# Copia este archivo como .env y rellena tus credenciales reales.
# Usa la clave secreta (sb_secret_...) o la antigua service_role de cada proyecto.
SUPABASE_SOMOS_LUZ_URL=https://TU-PROYECTO-A.supabase.co
SUPABASE_SOMOS_LUZ_KEY=

SUPABASE_CLIENTE_1_URL=https://TU-PROYECTO-B.supabase.co
SUPABASE_CLIENTE_1_KEY=

# --- Solo para el despliegue HTTP en el VPS ---
# Genera el token con: openssl rand -hex 32
MCP_AUTH_TOKEN=
MCP_DOMAIN=mcp.tudominio.com
TRAEFIK_NETWORK=root_default
TRAEFIK_CERTRESOLVER=mytlschallenge

# --- OAuth para el conector personalizado de claude.ai (opcional) ---
# Contraseña de la pantalla «Autorizar acceso» (mínimo 12 caracteres).
# Si se deja vacía, se usa MCP_AUTH_TOKEN.
OAUTH_PASSWORD=
# URL pública; por defecto https://${MCP_DOMAIN}
PUBLIC_URL=
